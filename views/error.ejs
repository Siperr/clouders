<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/error.css" />
    <title>Clouders - Error</title>
  </head>
  <body>
    <div id="error">
      <img id="error-img" src="/assets/images/error.svg"/>
      <div id="error-content">
        <h1>Error!</h2>
        <p id="message"><%= message %></p>
        <div id="go-back">
          <button><a href=<%= locals.back %>><img src="/assets/images/go-back.svg" /></a></button>
          <p>Go back</p>
        </div>
      </div>
    </div>
  </body>
</html>
