<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/folder.css">
    <link rel="stylesheet" href="/styles/sidebar.css">
    <script defer>
        function addFile(folderId) {
            window.location.href = `/folder/${folderId}/upload`;
        }

        function addFolder(folderId) {
            window.location.href = `/folder/${folderId}/new-folder`;
        }

        async function deleteFolder(folderId) {
            if (!confirm("Are you sure to delete this folder and all its contents?")) return;

            const url = `/folder/${Number(folderId)}/delete`;

            console.log("delete folder url: ", url);

            const response = await fetch(url, {
                method: "DELETE",
            });

            console.log("delete folder response: ", response);

            if (response.ok) {
                window.location.reload();
            } else {
                alert("Errore durante la cancellazione");
            }

            closeMenu('folder', folderId);
        }

        async function deleteFile(fileId) {
            if (!confirm("Are you sure to delete this file?")) return;

            const url = `/file/${Number(fileId)}/delete`;

            console.log("delete file url: ", url);

            const response = await fetch(url, {
                method: "DELETE",
            });

            console.log("delete file response: ", response);

            if (response.ok) {
                window.location.reload();
            } else {
                alert("Errore durante la cancellazione");
            }

            closeMenu('file', fileId);
        }

        async function openFolder(folderId){
            window.location.href = `/folder/${Number(folderId)}/`;
        }

        async function openFile(fileId){
            window.location.href = `/file/${Number(fileId)}/`;
        }

        function showMenu(type, idString) {
            const id = Number(idString);
            const menu = document.querySelector(
                `#${type}-${id} .menu`,
            );
            const menuBtn = document.querySelector(
                `#${type}-${id} .menu-btn`,
            );

            menu.hidden = !menu.hidden;

            if (menu.hidden) return;

            const rect = menuBtn.getBoundingClientRect();
            menu.style.position = "fixed";
            menu.style.left = `${rect.left - menu.offsetWidth + 230}px`;
            menu.style.top = `${rect.bottom - 50}px`;
        }

        function closeMenu(type, idString) {
            const id = Number(idString);
            const menu = document.querySelector(
                `#${type}-${id} .menu`,
            );

            menu.hidden = true;
        }

        function goBack(folderId) {
            console.log("goBack, folderId: ", folderId);
            const newPath = `/folder/${folderId}`;
            window.location.href = newPath;
        }

        function renameFolder(folderId, parentId) {
            const renameForm = `<div class="modal-container">
                <form id="rename-form" class='folder-form' action="/folder/${folderId}/rename?parent_id=${parentId}" method="POST">
                    <input type="text" id="new-folder-name" name="new-name"placeholder="New folder name" required>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="rename-btn" type="submit">Rename</button>
                </form>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', renameForm);
            closeMenu('folder', folderId);
        }

        function renameFile(fileId, parentId) {
            const renameForm = `<div class="modal-container">
                <form id="rename-form" class='folder-form' action="/file/${fileId}/rename?parent_id=${parentId}" method="POST">
                    <input type="text" id="new-file-name" name="new-file-name" placeholder="New file name" required>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="rename-btn" type="submit">Rename</button>
                </form>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', renameForm);
            closeMenu('file', fileId);
        }

        function cancelModal() {
            const modal = document.getElementsByClassName('modal-container')[0];
            if(modal)
                modal.remove();
        }

        async function moveFolder(folderName, folderId, parentName, parentId) {
            console.log("moveFolder, folderid: ", folderId, "parentId: ", parentId);
            const folders = await fetch('/folder/all');
            console.log("folders: ", folders);
            const foldersTree = await folders.json();
            console.log("foldersTree: ", foldersTree);

            function createOptions(node, level = 0){
                let result = [];

                result.push({
                    name: node.name,
                    id: node.id,
                    level: level
                });

                for(const n of node.children) {
                    result.push(...createOptions(n, level+1));
                }

                return result;
            }

            let options = createOptions(foldersTree);


            console.log('options: ', options);

            const moveForm = `<div class="modal-container">
                <div id="move-form-content">
                <h2>Move Folder "${folderName}"</h2>
                <p>Current position: ${parentName}</p>
                <form id="move-form" class='folder-form' action="/folder/${folderId}/move?parent_id=${parentId}" method="POST">
                    <label for="new-parent-folder">Move to:</label>
                    <select id="new-parent-folder" name="new-parent-folder" required>
                        ${options.map( o => {
                            return `<option value="${o.id}">${o.level !== 0 ? '|' : ''}${"--".repeat(o.level)} ${o.name}</option>`;
                        })}
                    </select>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="move-btn" type="submit">Move</button>
                </form>
                </div>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', moveForm);
            closeMenu('folder', folderId);
        }

        function moveFile(fileName, fileId, parentName, parentId, folderTree) {

            const foldersTree = JSON.parse(folderTree);

            function createOptions(node, level = 0){
                let result = [];

                result.push({
                    name: node.name,
                    id: node.id,
                    level: level
                });

                for(const n of node.children) {
                    result.push(...createOptions(n, level+1));
                }

                return result;
            }

            let options = createOptions(foldersTree);

            // console.log('options: ', options);

            const moveForm = `<div class="modal-container">
                <div id="move-form-content">
                <h2>Move File "${fileName}"</h2>
                <p>Current position: ${parentName}</p>
                <form id="move-form" class='folder-form' action="/file/${fileId}/move?parent_id=${parentId}" method="POST">
                    <label for="new-parent-folder">Move to:</label>
                    <select id="new-parent-folder" name="new-parent-folder" required>
                        ${options.map( o => {
                            return `<option value="${o.id}">${o.level !== 0 ? '|' : ''}${"--".repeat(o.level)} ${o.name}</option>`;
                        })}
                    </select>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="move-btn" type="submit">Move</button>
                </form>
                </div>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', moveForm);
            closeMenu('file', fileId);
        }

        function shareFolder(folderId, sharedList) {
            const innerList = JSON.parse(sharedList).length > 0 ? JSON.parse(sharedList).map( s => {
                return `<li><p>${s.username}</p>
                            <form id="update-permission-form" class='folder-form' action="/folder/${folderId}/share" method="POST">
                                <input type="hidden" name="user_id" value="${s.id}">
                                <select name="permission_update">
                                    <option value="read" ${s.permission === "READ" ? "selected" : ""}>Read</option>
                                    <option value="write" ${s.permission === "WRITE" ? "selected" : ""}>Write</option>
                                </select>
                                <button type="submit"><img class='form-icon' src="/assets/images/tick-icon.svg" alt="Update"></button>
                            </form>
                            <form id="unshare-form" class='folder-form' action="/folder/${folderId}/unshare" method="POST">
                                <input type="hidden" name="delete" value="${s.id}">
                                <button type="submit"><img class='form-icon' src="/assets/images/delete-icon.svg" alt="Delete"></button>
                            </form>
                        </li>`;
            }).join('') : `<li><p>No users</p></li>`;
            const shareForm = `<div class="modal-container">
                <div id='share-modal-content'>
                    <div id='shared-list'>
                        <h3>Already shared with:</h3>
                        <ul>
                            ${innerList}
                        </ul>
                    </div>
                    <div class="divider"></div>
                    <div id='share-form-container'>
                        <h3>Share with new user:</h3>
                        <form id="share-form" class='folder-form' action="/folder/${folderId}/share" method="POST">
                            <label for="username">Username</label>
                            <input type="text" id="username" name="username" placeholder="Enter username" required>
                            <label for="permission">Permission</label>
                            <select id="permission" name="permission" required>
                                <option value="read">Read</option>
                                <option value="write">Write</option>
                            </select>               
                            <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                            <button id="share-btn" type="submit">Share</button>
                        </form>
                    </div>
                </div>
            </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', shareForm);
            closeMenu('folder', folderId);
        }

        function shareFolderFormOnly(folderId) {
            const shareForm = `<div class="modal-container">
                <div id='share-modal-content'>
                    <div id='share-form-container'>
                        <h3>Share with new user:</h3>
                        <form id="share-form" class='folder-form' action="/folder/${folderId}/share" method="POST">
                            <label for="username">Username</label>
                            <input type="text" id="username" name="username" placeholder="Enter username" required>
                            <label for="permission">Permission</label>
                            <select id="permission" name="permission" required>
                                <option value="read">Read</option>
                                <option value="write">Write</option>
                            </select>               
                            <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                            <button id="share-btn" type="submit">Share</button>
                        </form>
                    </div>
                </div>
            </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', shareForm);
            closeMenu('folder', folderId);
        }

        function unshareFolder(folderId) {
            const unshareForm = `<div class="modal-container">
                <div class="modal-content">
                    <form id="unshare-form" class='folder-form' action="/folder/${folderId}/unshare" method="POST">
                        <p>Are you sure you want to unshare this folder?</p>
                        <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                        <button id="unshare-btn" type="submit">Unshare</button>
                    </form>
                </div>
            </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', unshareForm);
            closeMenu('folder', folderId);
        }

        document.addEventListener("DOMContentLoaded", () => {
        const addBtn = document.getElementById("add-btn");
        const menu = document.getElementById("add-menu");
        const menuOffset = 200;

        addBtn.addEventListener("click", (e) => {
            e.stopPropagation(); // opzionale, vedi sotto

            menu.hidden = !menu.hidden;

            if (menu.hidden) return;

            const rect = addBtn.getBoundingClientRect();

            menu.style.position = "fixed";
            menu.style.left = `${rect.left - menu.offsetWidth - 10}px`;
            menu.style.top = `${rect.bottom - menuOffset}px`;
        });

        document.addEventListener("click", (e) => {
            if (!menu.contains(e.target) && !addBtn.contains(e.target)) {
            menu.hidden = true;
            }
        });
        });
    </script>
    <title><%= title %></title>
</head>
<body>
    <%- include('partials/header', {user}) %>
    <main>
        <%- include('partials/sidebar', {folderTree, sharedFolders}) %>
        <div id="folder-contents">
            <div id="path-nav">
            <% if( locals.sharedInfo && locals.sharedInfo.permission !== "OWNER" ) { %>
                <div class="util-bar" id="shared-info">
                    <p>This folder is shared with you by <strong><%= sharedInfo.sharedBy %></strong> with <strong><%= sharedInfo.permission %></strong> permission.</p>
                </div>
                <img id="unlink-icon" src="/assets/images/unlink-icon.svg" alt="unlink icon" onclick="unshareFolder('<%= folder.id %>')">
            <% } else { %>
                    <svg id='back' xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" onclick="goBack('<%= pathParts.length <= 2 ? pathParts[0].id : pathParts.slice().reverse()[1].id %>')"><title>Back</title><path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" /></svg>
                    <div class="util-bar" id="path">
                        <% pathParts.forEach((element, index) => { %>
                            <p><a href="/folder/<%= element.id %>">
                                <%= element.name %>
                            </a></p>
                            <span>></span>
                        <% }); %>
                    </div>
                    <% if((locals.sharedInfo && locals.sharedInfo.permission === "OWNER")) { %>
                        <img id="share-icon" src="/assets/images/share-icon.svg" alt="share icon" onclick="shareFolder('<%= folder.id %>', '<%= JSON.stringify(sharedWith) %>')">
                    <% } %>
            <% } %>
            </div>
            <div id="contents">
                <% if (!folder.other_folders?.length && !folder.files?.length) { %>
                    <p id="empty-message">This folder is empty.</p>
                <% } else { %>

                    <% folder.other_folders?.forEach(subfolder => { %>
                        <%- include('partials/subfolder', {subfolder}) %>
                    <% }) %>

                    <% folder.files?.forEach(file => { %>
                        <%- include('partials/file', {file}) %>
                    <% }) %>

                <% } %>
            </div>
            <% if(!locals.sharedInfo || locals.sharedInfo.permission !== "READ") { %>
                <button id="add-btn"><img src="/assets/images/add.svg"></button>
                <div id="add-menu" hidden>
                    <h3>New</h3>
                    <hr>
                    <ul>
                        <li id='add-file' onClick="addFile('<%= folder.id %>')">File</li>
                        <li id='add-folder' onClick="addFolder('<%= folder.id %>')">Folder</li>
                    </ul>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>