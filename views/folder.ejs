<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/folder.css">
    <script defer>
        function addFile() {
            const currFolder = window.location.pathname.split("/")[2] || "";
            window.location.href = `/folder/${currFolder}/upload`;
        }

        function addFolder() {
            const currFolder = window.location.pathname.split("/")[2] || "";
            window.location.href = `/folder/${currFolder}/new-folder`;
        }

        async function deleteFolder(folderId) {
            if (!confirm("Are you sure to delete this folder and all its contents?")) return;

            const url = `/folder/${Number(folderId)}/delete`;

            console.log("delete folder url: ", url);

            const response = await fetch(url, {
                method: "DELETE",
            });

            console.log("delete folder response: ", response);

            if (response.ok) {
                window.location.reload();
            } else {
                alert("Errore durante la cancellazione");
            }

            closeMenu('folder', folderId);
        }

        async function deleteFile(fileId) {
            if (!confirm("Are you sure to delete this file?")) return;

            const url = `/file/${Number(fileId)}/delete`;

            console.log("delete file url: ", url);

            const response = await fetch(url, {
                method: "DELETE",
            });

            console.log("delete file response: ", response);

            if (response.ok) {
                window.location.reload();
            } else {
                alert("Errore durante la cancellazione");
            }

            closeMenu('file', fileId);
        }

        async function openFolder(folderId){
            window.location.href = `/folder/${Number(folderId)}/`;
        }

        async function openFile(fileId){
            window.location.href = `/file/${Number(fileId)}/`;
        }

        function showMenu(type, idString) {
            const id = Number(idString);
            const menu = document.querySelector(
                `#${type}-${id} .menu`,
            );
            const menuBtn = document.querySelector(
                `#${type}-${id} .menu-btn`,
            );

            menu.hidden = !menu.hidden;

            if (menu.hidden) return;

            const rect = menuBtn.getBoundingClientRect();
            menu.style.position = "fixed";
            menu.style.left = `${rect.left - menu.offsetWidth + 230}px`;
            menu.style.top = `${rect.bottom - 50}px`;
        }

        function closeMenu(type, idString) {
            const id = Number(idString);
            const menu = document.querySelector(
                `#${type}-${id} .menu`,
            );

            menu.hidden = true;
        }

        function goBack(folderId) {
            console.log("goBack, folderId: ", folderId);
            const newPath = `/folder/${folderId}`;
            window.location.href = newPath;
        }

        function renameFolder(folderId, parentId) {
            const renameForm = `<div class="modal-container">
                <form id="rename-form" action="/folder/${folderId}/rename?parent_id=${parentId}" method="POST">
                    <input type="text" id="new-folder-name" name="new-name"placeholder="New folder name" required>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="rename-btn" type="submit">Rename</button>
                </form>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', renameForm);
            closeMenu('folder', folderId);
        }

        function renameFile(fileId, parentId) {
            const renameForm = `<div class="modal-container">
                <form id="rename-form" action="/file/${fileId}/rename?parent_id=${parentId}" method="POST">
                    <input type="text" id="new-file-name" name="new-file-name" placeholder="New file name" required>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="rename-btn" type="submit">Rename</button>
                </form>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', renameForm);
            closeMenu('file', fileId);
        }

        function cancelModal() {
            const modal = document.getElementsByClassName('modal-container')[0];
            if(modal)
                modal.remove();
        }

        async function moveFolder(folderName, folderId, parentName, parentId) {
            console.log("moveFolder, folderid: ", folderId, "parentId: ", parentId);
            const folders = await fetch('/folder/all');
            console.log("folders: ", folders);
            const foldersTree = await folders.json();
            console.log("foldersTree: ", foldersTree);

            function createOptions(node, level = 0){
                let result = [];

                result.push({
                    name: node.name,
                    id: node.id,
                    level: level
                });

                for(const n of node.children) {
                    result.push(...createOptions(n, level+1));
                }

                return result;
            }

            let options = createOptions(foldersTree);


            console.log('options: ', options);

            const moveForm = `<div class="modal-container">
                <div id="move-form-content">
                <h2>Move Folder "${folderName}"</h2>
                <p>Current position: ${parentName}</p>
                <form id="move-form" action="/folder/${folderId}/move?parent_id=${parentId}" method="POST">
                    <label for="new-parent-folder">Move to:</label>
                    <select id="new-parent-folder" name="new-parent-folder" required>
                        ${options.map( o => {
                            return `<option value="${o.id}">${o.level !== 0 ? '|' : ''}${"--".repeat(o.level)} ${o.name}</option>`;
                        })}
                    </select>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="move-btn" type="submit">Move</button>
                </form>
                </div>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', moveForm);
            closeMenu('folder', folderId);
        }

        async function moveFile(fileName, fileId, parentName, parentId) {
            console.log("moveFile, fileid: ", fileId, "parentId: ", parentId);
            const folders = await fetch('/folder/all');
            console.log("folders: ", folders);
            const foldersTree = await folders.json();
            console.log("foldersTree: ", foldersTree);

            function createOptions(node, level = 0){
                let result = [];

                result.push({
                    name: node.name,
                    id: node.id,
                    level: level
                });

                for(const n of node.children) {
                    result.push(...createOptions(n, level+1));
                }

                return result;
            }

            let options = createOptions(foldersTree);

            console.log('options: ', options);

            const moveForm = `<div class="modal-container">
                <div id="move-form-content">
                <h2>Move File "${fileName}"</h2>
                <p>Current position: ${parentName}</p>
                <form id="move-form" action="/file/${fileId}/move?parent_id=${parentId}" method="POST">
                    <label for="new-parent-folder">Move to:</label>
                    <select id="new-parent-folder" name="new-parent-folder" required>
                        ${options.map( o => {
                            return `<option value="${o.id}">${o.level !== 0 ? '|' : ''}${"--".repeat(o.level)} ${o.name}</option>`;
                        })}
                    </select>
                    <button id="cancel-btn" type="button" onclick="cancelModal()">Cancel</button>
                    <button id="move-btn" type="submit">Move</button>
                </form>
                </div>
                </div>`;

            const folderContent = document.getElementById('folder-contents');
            folderContent.insertAdjacentHTML('beforeend', moveForm);
            closeMenu('file', fileId);
        }

        document.addEventListener("DOMContentLoaded", () => {
        const addBtn = document.getElementById("add-btn");
        const menu = document.getElementById("add-menu");
        const menuOffset = 200;

        addBtn.addEventListener("click", (e) => {
            e.stopPropagation(); // opzionale, vedi sotto

            menu.hidden = !menu.hidden;

            if (menu.hidden) return;

            const rect = addBtn.getBoundingClientRect();

            menu.style.position = "fixed";
            menu.style.left = `${rect.left - menu.offsetWidth - 10}px`;
            menu.style.top = `${rect.bottom - menuOffset}px`;
        });

        document.addEventListener("click", (e) => {
            if (!menu.contains(e.target) && !addBtn.contains(e.target)) {
            menu.hidden = true;
            }
        });
        });
    </script>
    <title><%= title %></title>
</head>
<body>
    <%- include('partials/header', {user}) %>
    <div id="path-nav">
        <svg id='back' xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" onclick="goBack('<%= pathParts.length <= 2 ? pathParts[0].id : pathParts[1].id %>')"><title>Back</title><path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" /></svg>
        <div id="path">
            <% pathParts.forEach((element, index) => { %>
                <p><a href="/folder/<%= element.id %>">
                    <%= element.name %>
                </a></p>
                <p>></p>
            <% }); %>
        </div>
    </div>
    <main>
        <div id="folder-contents">
            <% if (!folder.other_folders?.length && !folder.files?.length) { %>
                <p id="empty-message">This folder is empty.</p>
            <% } else { %>

                <% folder.other_folders?.forEach(subfolder => { %>
                    <%- include('partials/subfolder', {subfolder}) %>
                <% }) %>

                <% folder.files?.forEach(file => { %>
                    <%- include('partials/file', {file}) %>
                <% }) %>

            <% } %>
            <button id="add-btn"><img src="/assets/images/add.svg"></button>
            <div id="add-menu" hidden>
                <h3>New</h3>
                <hr>
                <ul>
                    <li id='add-file' onClick="addFile()">File</li>
                    <li id='add-folder' onClick="addFolder()">Folder</li>
                </ul>
            </div>
        </div>
    </main>
</body>
</html>