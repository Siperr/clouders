<header>
    <h1 href="/">Clouders</h1>
    <nav>
        <ul>
            <% if (!locals.user) {%>
                <li id="login-btn"><a href="/login">Login</a></li>
                <li id="signup-btn"><a href="/signup">Signup</a></li>
            <% } else { %>
                <li id="logout-btn">
                    <form id="logout-form" action="/logout" method="POST">
                        <button type="submit">Logout</button>
                    </form>
                </li>
            <%}%>
        </ul>
    </nav>
</header>