<div class="folder" id="folder-<%= subfolder.id %>">
    <div class="icon-menu">
        <% if (subfolder.shared) { %>
            <img class="folder-icon" src="/assets/images/shared-folder-icon.svg" alt="shared folder icon" onclick="openFolder('<%= subfolder.id %>')">
        <% } else { %>
            <img class="folder-icon" src="/assets/images/folder-icon.svg" alt="folder icon" onclick="openFolder('<%= subfolder.id %>')">
        <% } %>
        <svg onclick="showMenu('folder', '<%= subfolder.id %>')" class='menu-btn' xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z" /></svg>
    </div>
    <div class="menu" hidden>
        <svg class='close-btn' onclick="closeMenu('folder', '<%= subfolder.id %>')" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" /></svg>
        <ul>
            <li onClick="deleteFolder('<%= subfolder.id %>')">Delete</li>
            <li onClick="renameFolder('<%= subfolder.id %>', '<%= subfolder.parent_folder_id %>')">Rename</li>
            <li onClick="moveFolder('<%= subfolder.name %>', '<%= subfolder.id %>', '<%= folder.name %>', '<%= subfolder.parent_folder_id %>')">Move</li>
            <% if (subfolder.isShared) { %>
                <li onClick="unshareFolder('<%= subfolder.id %>')">Unshare</li>
            <% } else { %>
                <li onClick="shareFolderFormOnly('<%= subfolder.id %>')">Share</li>
            <% } %>
        </ul>
    </div>
    <p class="folder-name"><%= subfolder.name %></p>
</div>