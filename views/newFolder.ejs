<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/newFolder.css">
    <title>Clouders - New Folder</title>
</head>
<body>
    <main>
        <h2>Add a folder</h2>
        <form action="/folder/<%= folder.id %>/new-folder" method="POST">
            <label for="folder-name"></label>
            <input type="text" id="folder-name" name="folder-name" placeholder="New folder">
            <button type="submit">Submit</button>
        </form>
    </main>
</body>
</html>