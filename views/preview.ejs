<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/preview.css" />
    <title>Preview - <%= file.originalName %></title>
</head>
<body>
    <main>
    <% console.log('file: ', file) %>
    <div class="toolbar">
        <svg id='back' xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" onclick="window.location.href='/folder/<%= file.folder_id %>'"><title>Back</title><path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" /></svg>
        <h2><%= file.name %></h2>
        <a href="<%= signedUrlDownload %>">
            <img id="download" src="/assets/images/download.svg" alt="Download">
        </a>
    </div>


    <div class="preview-container">
        <% if (file.mime_type.startsWith("image/")) { %>

            <img src="<%= signedUrl %>" alt="<%= file.originalName %>">


        <% } else if (file.mime_type === "application/pdf") { %>

            <iframe src="<%= signedUrl %>"></iframe>



        <% } else if (file.mime_type.startsWith("video/")) { %>

            <video controls>
                <source src="<%= signedUrl %>" type="<%= file.mimeType %>">
                The browser does not support this video.
            </video>



        <% } else if (file.mime_type.startsWith("audio/")) { %>

            <audio controls>
                <source src="<%= signedUrl %>" type="<%= file.mimeType %>">
                The browser does not support this audio.
            </audio>



        <% } else if (file.mime_type.startsWith("text/")) { %>

            <iframe src="<%= signedUrl %>"></iframe>


        <% } else { %>

            <p>
                Preview not available for this file type.
            </p>

            <a href="<%= signedUrlDownload %>">
                Download file
            </a>

        <% } %>
    </div>
    </main>
</body>
</html>