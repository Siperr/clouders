generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model files {
  id         Int      @id @default(autoincrement())
  name       String
  size       Int
  mime_type  String
  path       String
  owner_id   Int
  folder_id  Int
  created_at DateTime @default(now())
  folders    folders  @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model folders {
  id               Int              @id @default(autoincrement())
  name             String
  parent_folder_id Int?
  owner_id         Int
  created_at       DateTime         @default(now())
  files            files[]
  users            users            @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  folders          folders?         @relation("foldersTofolders", fields: [parent_folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_folders    folders[]        @relation("foldersTofolders")
  shared_folders   shared_folders[]
}

model session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime @map("expires_at")
  user_id   Int?
  users     users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
}

enum Permission {
  READ
  WRITE
  OWNER
}

model shared_folders {
  folder_id Int
  user_id   Int
  permission Permission @default(READ)
  folders   folders @relation(fields: [folder_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([folder_id, user_id])
}

model users {
  id             Int              @id @default(autoincrement())
  username       String           @unique
  password       String
  created_at     DateTime         @default(now())
  files          files[]
  folders        folders[]
  sessions       session[]
  shared_folders shared_folders[]
}
